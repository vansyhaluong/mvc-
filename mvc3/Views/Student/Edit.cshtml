@{
}
@model mvc3.Models.Student

<form method="post">
    <div>
        <label asp-for="Id">Id</label>
        <input type="number" asp-for="Id" class="form-control" readonly/>
    </div>
    <div>
        <label>Name</label>
        <input type="text" asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label>Age</label>
        <input type="number" asp-for="Age" class="form-control" />
    </div>
    <button type="submit">
        Lưu thay đổi
    </button>
</form>