@{
}
@model List<mvc3.Models.Student>
<h2>Danh sách sinh viên</h2>
<a class="btn btn-primary" asp-action="Create">Thêm mới</a>
<table border="1" cellpadding="10">
    <tr>
        <th>ID</th>
        <th>NAME</th>
        <th>AGE</th>
        <th>ACTION</th>
    </tr>
    @foreach(var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Name</td>
            <td>@item.Age</td>
            <td>
                <a class="btn btn-warning" asp-action="Edit"  asp-route-id="@item.Id">Sửa</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
            </td>
        </tr>
    }
</table>